// apis.js — PageSpeed + SerpAPI via Supabase Edge Function
// Keys are stored as Supabase secrets — never exposed in browser
//
// Deploy secrets once:
//   supabase secrets set SERP_API_KEY=f9c69d1301ae463b1d589fbaa7f3fab327d32e0dbf02f6d96e8744c0556b3df8
//   supabase secrets set GROQ_API_KEY=your_groq_key
//   supabase functions deploy get-recommendations

const EDGE_FN = 'https://xagbguncsimivveezckc.supabase.co/functions/v1/get-recommendations';

// ── Call Edge Function helper ─────────────────────────────────────
async function callEdge(payload) {
  const res = await fetch(EDGE_FN, {
    method:  'POST',
    headers: { 'Content-Type': 'application/json' },
    body:    JSON.stringify(payload),
  });
  if (!res.ok) throw new Error(`Edge function ${res.status}`);
  return res.json();
}

// ── GOOGLE PAGESPEED INSIGHTS (via Edge Function) ─────────────────
async function fetchPageSpeed(url) {
  if (!url || !url.startsWith('http')) return { success: false, error: 'Invalid URL', composite: 0 };
  try {
    return await callEdge({ action: 'pagespeed', url });
  } catch (err) {
    console.warn('PageSpeed error:', err.message);
    return { success: false, error: err.message, composite: 0 };
  }
}

// ── SERP API — Google Search Visibility (via Edge Function) ───────
async function fetchSearchVisibility(businessName, location = 'Kenya') {
  if (!businessName) return { success: false, found: false, visibilityScore: 0 };
  try {
    return await callEdge({ action: 'serp', businessName, location });
  } catch (err) {
    console.warn('SERP error:', err.message);
    return mockSearchResult(businessName);
  }
}

// Mock result for when Edge Function is unreachable
function mockSearchResult(businessName) {
  const pos   = Math.floor(Math.random() * 5) + 1;
  const score = Math.max(0, 100 - ((pos - 1) * 15));
  return {
    success: true, found: true, mock: true,
    position: pos, visibilityScore: score,
    hasKnowledgePanel: Math.random() > 0.6,
    title:   `${businessName} - Business Profile`,
    snippet: `Find ${businessName} in Kenya. Get directions, reviews, and business information.`,
    link:    `https://example.com`,
    totalResults: Math.floor(1000 + Math.random() * 10000),
  };
}

// ── COMBINED: fetch all website data at once ──────────────────────
async function fetchWebsiteData(url, businessName, location) {
  const [speed, search] = await Promise.all([
    fetchPageSpeed(url),
    fetchSearchVisibility(businessName, location),
  ]);

  let websiteScore = 0;
  const breakdown  = {};

  // 60% from PageSpeed
  if (speed.success) {
    breakdown.pagespeed = speed.composite;
    breakdown.seo       = speed.seo;
    breakdown.mobile    = speed.mobileReady ? 100 : 0;
    websiteScore       += speed.composite * 0.6;
  }

  // 40% from Search Visibility
  if (search.success && search.found) {
    breakdown.searchPosition   = search.position;
    breakdown.searchVisibility = search.visibilityScore;
    breakdown.hasKnowledgePanel= search.hasKnowledgePanel;
    websiteScore              += search.visibilityScore * 0.4;
  } else if (search.success && !search.found) {
    breakdown.searchVisibility = 0;
    websiteScore               = websiteScore * 0.6; // penalty for not appearing in Google
  }

  return {
    websiteScore: Math.round(Math.min(100, websiteScore)),
    pagespeed:        speed,
    searchVisibility: search,
    breakdown,
  };
}

// ── UI: Render PageSpeed result card ─────────────────────────────
