    el.innerHTML = `<div style="padding:10px 14px;background:#f1f5f9;border-radius:8px;font-size:12px;color:#64748b;margin-top:8px;">
      Could not analyse website. Check the URL is correct and publicly accessible.</div>`;
    return;
  }
  const c = result.composite >= 70 ? '#10b981' : result.composite >= 50 ? '#f59e0b' : '#ef4444';
  el.innerHTML = `
    <div style="background:#f8fafc;border-radius:12px;padding:14px 16px;margin-top:10px;border:1px solid #e2e8f0;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
        <span style="font-size:12px;font-weight:600;color:#64748b;">📊 PageSpeed Score</span>
        <span style="font-family:monospace;font-size:20px;font-weight:700;color:${c};">${result.composite}</span>
      </div>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;font-size:11px;text-align:center;">
        <div><div style="font-weight:700;color:${result.performance>=70?'#10b981':result.performance>=50?'#f59e0b':'#ef4444'}">${result.performance}</div><div style="color:#64748b">Performance</div></div>
        <div><div style="font-weight:700;color:${result.seo>=70?'#10b981':result.seo>=50?'#f59e0b':'#ef4444'}">${result.seo}</div><div style="color:#64748b">SEO</div></div>
        <div><div style="font-weight:700;color:${result.accessibility>=70?'#10b981':result.accessibility>=50?'#f59e0b':'#ef4444'}">${result.accessibility}</div><div style="color:#64748b">Accessibility</div></div>
      </div>
      <div style="margin-top:8px;font-size:11px;color:#64748b;display:flex;gap:12px;">
        <span>FCP: ${result.fcp}</span>
        <span>LCP: ${result.lcp}</span>
        <span>${result.mobileReady ? '✅ Mobile ready' : '⚠️ Not mobile ready'}</span>
      </div>
    </div>`;
}

// ── UI: Render Search Visibility result card ──────────────────────
function renderSearchResult(result, containerId = 'search-result') {
  const el = document.getElementById(containerId);
  if (!el) return;
  if (!result.success || !result.found) {
    el.innerHTML = `<div style="padding:10px 14px;background:#fee2e2;border-radius:8px;font-size:12px;color:#991b1b;margin-top:8px;">
      ⚠️ Business not found in Google Search. This reduces your Platform Presence score.
      <a href="https://business.google.com" target="_blank" style="color:#991b1b;font-weight:600;"> Create a free Google Business listing →</a></div>`;
    return;
  }
  const c    = result.visibilityScore >= 70 ? '#10b981' : result.visibilityScore >= 50 ? '#f59e0b' : '#ef4444';
  const icon = result.position === 1 ? '🥇' : result.position === 2 ? '🥈' : result.position === 3 ? '🥉' : '📊';
  el.innerHTML = `
    <div style="background:#f8fafc;border-radius:12px;padding:14px 16px;margin-top:10px;border:1px solid #e2e8f0;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
        <span style="font-size:12px;font-weight:600;color:#64748b;">${result.mock?'🎭 Demo: ':'🔍 '}Google Search</span>
        <span style="font-size:11px;background:#dcfce7;color:#14532d;padding:2px 8px;border-radius:10px;font-weight:600;">${icon} #${result.position}</span>
      </div>
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
        <span style="font-size:13px;font-weight:600;">Visibility Score</span>
        <span style="font-family:monospace;font-size:20px;font-weight:700;color:${c};">${result.visibilityScore}</span>
      </div>
      <div style="font-size:12px;color:#64748b;">
        ${result.title ? `<div><strong>Found as:</strong> ${result.title}</div>` : ''}
        ${result.snippet ? `<div style="margin-top:4px;">${result.snippet}</div>` : ''}
        ${result.hasKnowledgePanel ? '<div style="margin-top:4px;color:#10b981;">✅ Google Knowledge Panel active</div>' : ''}
      </div>
    </div>`;
}